# OpenAI
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxx

VITE_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=YOUR_PUBLISHABLE_KEY

# Models
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_GRADER_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Qdrant (run locally: docker run -p 6333:6333 qdrant/qdrant)
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=chaibooklm_chunks

# Postgres (via docker-compose)
DATABASE_URL=postgres://postgres:postgres@localhost:5433/chaibooklm

# Redis (for BullMQ background processing)
REDIS_URL=redis://localhost:6380

# Server
PORT=3002
