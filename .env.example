# OpenAI
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxx

VITE_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=YOUR_PUBLISHABLE_KEY

# Frontend: base URL of the deployed backend API (leave unset for local dev,
# where it defaults to http://localhost:3002/api)
VITE_API_BASE=

# Models
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_GRADER_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Qdrant (run locally: docker run -p 6333:6333 qdrant/qdrant)
# For production on Render's free tier, use a Qdrant Cloud free cluster
# instead (https://cloud.qdrant.io) - copy its URL + API key here.
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=chaibooklm_chunks
QDRANT_API_KEY=

# Postgres (via docker-compose locally)
# For production, use a Neon free Postgres project (https://neon.tech) -
# copy its connection string here (must include ?sslmode=require).
DATABASE_URL=postgres://postgres:postgres@localhost:5433/chaibooklm

# Redis (for BullMQ background processing)
# For production, use an Upstash free Redis database (https://upstash.com) -
# copy its connection string here (use the "ioredis"/TLS URL, starts with rediss://).
REDIS_URL=redis://localhost:6380

# Mem0 (long-term per-notebook memory of facts/preferences the user has
# stated, recalled by relevance rather than lost once they scroll out of
# recent chat history). Get a free API key at https://app.mem0.ai
# Optional: if unset, memory is silently skipped and everything else still works.
MEM0_API_KEY=

# Server
PORT=3002
